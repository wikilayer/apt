#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || ! $1 =~ ^[a-z0-9][a-z0-9.+-]*$ || ! $2 =~ ^[0-9][0-9A-Za-z.+~-]*$ ]]; then
  echo "usage: bin/withdraw <package> <version>" >&2
  exit 2
fi

name=$1
version=$2
dir="pool/main/${name:0:1}/$name"
shopt -s nullglob
withdrawn=("$dir/${name}_${version}_"*.deb)
if [[ ${#withdrawn[@]} -eq 0 ]]; then
  echo "$name $version is not in the pool" >&2
  exit 1
fi
remaining=0
for deb in "$dir"/*.deb; do
  [[ $deb == "$dir/${name}_${version}_"* ]] || remaining=$((remaining + 1))
done
if [[ $remaining -eq 0 ]]; then
  echo "$name $version is the only version in the pool; publish the next one first, or apt install $name stops working" >&2
  exit 1
fi

for deb in "${withdrawn[@]}"; do
  rm "$deb"
  echo "withdrew $deb"
done
